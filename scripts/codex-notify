#!/usr/bin/env -S python3 -B
"""Augment native Codex completions through configured desktop or terminal routes."""

from pathlib import Path
import subprocess
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from codex_plus.notifications import is_subagent, main, notification, terminal

if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] in ('hook', 'desktop', 'desktop-worker'):
        import argparse
        import json
        from codex_plus.notification_delivery import config_path, hook, load_config, read_event
        parser = argparse.ArgumentParser(description=__doc__)
        parser.add_argument('--config', type=Path, default=config_path())
        parser.add_argument('payload', nargs='?')
        args = parser.parse_args(sys.argv[2:])
        try:
            if sys.argv[1] == 'hook':
                if args.payload is None or len(args.payload.encode()) > 1048576:
                    raise ValueError('missing or oversized native notification')
                result = hook(json.loads(args.payload), load_config(args.config))
                if result is not None and result['status'] == 'uncertain':
                    raise ValueError('desktop admission uncertain')
            else:
                if args.payload is not None:
                    raise ValueError('desktop delivery reads one event from stdin')
                from codex_plus.notification_desktop import receive, worker
                event = read_event(sys.stdin.buffer)
                emit = lambda value: print(json.dumps(value, separators=(',', ':')), flush=True)
                if sys.argv[1] == 'desktop':
                    emit(receive(event, args.config, Path(__file__).resolve()))
                else:
                    worker(event, load_config(args.config), emit=emit)
        except (OSError, ValueError, RuntimeError, TimeoutError, subprocess.SubprocessError) as error:
            # Native completion must remain successful; explicit commands report uncertainty.
            print('codex-notify: ' + str(error), file=sys.stderr)
            sys.exit(0 if sys.argv[1] == 'hook' else 2)
    elif len(sys.argv) > 1 and sys.argv[1] in ('run', 'launch', 'inspect', 'identity'):
        import argparse
        import asyncio
        import json
        from codex_plus.notification_inspect import default_socket, main as inspect_main, source_identity
        parser = argparse.ArgumentParser(description=__doc__)
        parser.add_argument('--socket', default=default_socket())
        if sys.argv[1] in ('run', 'launch'):
            parser.add_argument('--native', default='/usr/bin/codex')
        rest = sys.argv[2:]
        boundary = rest.index('--') if '--' in rest else len(rest)
        args = parser.parse_args(rest[:boundary])
        arguments = rest[boundary + 1:]
        command = sys.argv[1]
        if command not in ('run', 'launch') and arguments:
            parser.error('only run/launch accept native arguments')
        try:
            if command == 'inspect':
                inspect_main(args.socket)
            elif command == 'identity':
                host, instance = source_identity(args.socket)
                print(json.dumps({'host': host, 'instance': instance}))
            elif command == 'launch':
                from codex_plus.notification_launcher import launch
                sys.exit(launch(args.socket, arguments, args.native))
            else:
                from codex_plus.notification_run import run
                from codex_plus.notification_launcher import native_exit
                sys.exit(native_exit(asyncio.run(run(args.socket, arguments, args.native))))
        except (OSError, ValueError, RuntimeError, TimeoutError, subprocess.SubprocessError) as error:
            print('codex-notify: ' + str(error), file=sys.stderr)
            sys.exit(2)
    else:
        main()
