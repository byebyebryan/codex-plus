def site_theme(landing: str) -> tuple[str, str]:
    blocks = re.findall(r'<style id="site-theme">.*?</style>', landing, flags=re.S)
    if len(blocks) != 1:
        raise ValueError("landing page needs exactly one site theme style block")
    color = re.search(r'--paper\s*:\s*(#[0-9a-f]{6})\s*(?=[;}])', blocks[0], flags=re.I)
    if not color:
        raise ValueError("site theme needs a six-digit --paper color")
    return blocks[0], color[1].lower()


def rewrite_link(url: str, prefix: str) -> str:
    parsed = urlsplit(url)
    fragment = "#" + parsed.fragment if parsed.fragment else ""
    if url.startswith(SITE):
        return prefix + parsed.path[len(urlsplit(SITE).path):] + (("?" + parsed.query) if parsed.query else "") + fragment
    if parsed.scheme:
        if not url.startswith(SOURCE):
            return url
        name = unquote(parsed.path).split("/docs/", 1)[1]
    else:
        if not parsed.path or parsed.path.startswith("/"):
            return url
        name = unquote(parsed.path)
    if name in GUIDES:
        return prefix + GUIDES[name][0] + "/" + fragment
    if name in {"presentation.md", "presentation/index.html"}:
        return prefix + "walkthrough/" + fragment
    if name == "presentation/overview.html":
        return prefix + fragment
    if not parsed.scheme and name.endswith(".md"):
        return SOURCE + name + fragment
    return url


class Links(HTMLParser):
    def __init__(self, prefix: str):
        super().__init__(convert_charrefs=False)
        self.prefix = prefix
        self.parts: list[str] = []

    def tag(self, tag, attrs, suffix):
        rendered = []
        for key, value in attrs:
            if key == "href" and value:
                value = rewrite_link(value, self.prefix)
            if tag == "a" and key == "id" and value:
                value = value.removeprefix("user-content-")
            rendered.append(key if value is None else f'{key}="{html.escape(value, quote=True)}"')
        self.parts.append("<" + tag + (" " if rendered else "") + " ".join(rendered) + suffix)

    def handle_starttag(self, tag, attrs):
        self.tag(tag, attrs, ">")

    def handle_startendtag(self, tag, attrs):
        self.tag(tag, attrs, " />")

    def handle_endtag(self, tag):
        self.parts.append(f"</{tag}>")

    def handle_data(self, data):
        self.parts.append(data)

    def handle_entityref(self, name):
        self.parts.append("&" + name + ";")

    def handle_charref(self, name):
        self.parts.append("&#" + name + ";")

    def handle_comment(self, data):
        self.parts.append("<!--" + data + "-->")

    def handle_decl(self, declaration):
        self.parts.append("<!" + declaration + ">")


def links(text: str, prefix: str) -> str:
    parser = Links(prefix)
    parser.feed(text)
    parser.close()
    return "".join(parser.parts)


def headings(text: str) -> str:
    seen: dict[str, int] = {}

    def replace(match):
        title = html.unescape(re.sub(r"<[^>]+>", "", match[3])).lower()
        slug = re.sub(r"[^\w\s-]", "", title)
        slug = re.sub(r"\s", "-", slug)
        number = seen.get(slug, 0)
        seen[slug] = number + 1
        identifier = slug if not number else f"{slug}-{number}"
        return f'<h{match[1]} id="{identifier}"{match[2]}>{match[3]}</h{match[1]}>'

    return re.sub(r"<h([1-6])([^>]*)>(.*?)</h\1>", replace, text, flags=re.S)


def render(markdown: str) -> str:
    command = ["gh", "api", "--hostname", "github.com", "markdown", "--method", "POST", "--input", "-"]
    if shutil.which("rtk"):
        command = ["rtk", "proxy", *command]
    result = subprocess.run(command, input=json.dumps({"text": markdown, "mode": "gfm", "context": REPOSITORY}),
                            capture_output=True, text=True, timeout=60)
    if result.returncode:
        raise RuntimeError("GitHub Markdown rendering failed: " + result.stderr.strip())
    return result.stdout


def architecture_diagram(text: str, markdown: str) -> str:
    code = re.search(r"```mermaid\n(.*?)\n```", markdown, re.S)
    if not code:
        raise ValueError("architecture diagram source is missing")
    svg = (ROOT / "docs/presentation/architecture.svg").read_text()
    digest = hashlib.sha256(code[1].encode()).hexdigest()
    if f'data-source-sha256="{digest}"' not in svg:
        raise ValueError("update the authored SVG alongside the architecture diagram source")
    figure = ('<figure tabindex="0" aria-label="Observation and native follow-up diagram">'
              '<img src="../assets/architecture.svg" alt="Requests, bounded sources and timers return to the native conversation; MCP calls use normal native approval and reports are independent.">'
              '<figcaption>Observation and native follow-up. <a href="' + SOURCE + 'presentation/architecture.svg">Diagram source on GitHub</a>.</figcaption></figure>')
    text, count = re.subn(r'<section\b[^>]*data-type="mermaid"[^>]*>.*?</section>', figure, text, flags=re.S)
    if count != 1 or 'data-type="mermaid"' in text:
        raise ValueError("unexpected GitHub Mermaid rendering; refusing incomplete diagram")
    return text


def guide_figure(name: str, body: str) -> str:
    if name not in GUIDE_FIGURES:
        return body
    anchor, tag = GUIDE_FIGURES[name]
    heading = re.search(rf'<h[2-6]\b[^>]*\bid="{re.escape(anchor)}"[^>]*>.*?</h[2-6]>', body, re.S)
    if not heading:
        return body
    next_heading = re.search(r'<h[2-6]\b', body[heading.end():])
    end = heading.end() + next_heading.start() if next_heading else len(body)
    section = body[heading.end():end]
    layout = 'guide-steps' if tag == 'ol' else 'guide-choices'
    section = re.sub(rf'<{tag}\b', f'<{tag} class="guide-figure {layout}" role="list"', section, count=1)
    return body[:heading.end()] + section + body[end:]


def guide_page(name: str, route: str, title: str, body: str, icon: str,
               theme: tuple[str, str], requests: dict[str, str] | None = None) -> str:
    if requests:
        body = action_table(body, requests)
    theme_style, theme_color = theme
    nav = ('<a href="../">Overview</a><a href="../walkthrough/">Walkthrough</a>'
           '<a href="../#guide-directory">Guides</a><a href="../manage/">Install</a>')
    sections = re.findall(r'<h2\b[^>]*\bid="([^"]+)"[^>]*>(.*?)</h2>', body, re.S)
    toc = ('<details class="toc"><summary>On this page</summary><nav aria-label="On this page"><ol>' + ''.join(
        '<li><a href="#' + html.escape(identifier, quote=True) + '">' +
        html.escape(html.unescape(re.sub(r'<[^>]+>', '', heading))) + '</a></li>'
        for identifier, heading in sections) + '</ol></nav></details>') if sections else ''
    body = re.sub(r"<table\b([^>]*)>", r'<div class="table-scroll" tabindex="0" role="region" aria-label="Scrollable table"><table\1>', body)
    body = body.replace("</table>", "</table></div>")
    intro = re.search(r'</h1>(?:\s*<p\b[^>]*>.*?</p>)?', body, re.S)
    contents_position = intro.end() if intro else 0
    body = body[:contents_position] + toc + body[contents_position:]
    feature_guides = ('daily-use.md', 'html-report-usage.md', 'session-communication.md', 'workers.md')
    more = '<aside class="more" aria-label="Related guides"><strong>Explore the features</strong>' + ''.join(
        f'<a href="../{GUIDES[guide][0]}/">{GUIDES[guide][1]}</a>'
        for guide in feature_guides if guide != name) + '</aside>'
    page_title = title + ' — Codex Plus'
    page_metadata = metadata(SITE + route + '/', page_title, DESCRIPTIONS[name], theme_color)
    return (f'<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">'
            f'<title>{html.escape(page_title)}</title>{page_metadata}{icon}{theme_style}<style>{STYLE}</style></head><body>'
            '<a class="skip" href="#main">Skip to content</a>'
            f'<header><a class="wordmark" href="../" aria-label="Codex Plus home">codex<span aria-hidden="true">+</span></a>'
            f'<nav class="guide-nav" aria-label="Public guides">{nav}</nav></header>'
            '<main id="main" tabindex="-1"><p class="guide-trail"><a href="../#guide-directory">Guide directory</a>'
            f'<span aria-current="page">{html.escape(title)}</span></p>'
            + ('<p class="source"><a href="../manage.md">Plain Markdown for your agent</a></p>' if route == 'manage' else '')
            + f'{body}{more}</main><footer><a href="{SOURCE}{name}">Source on GitHub</a>'
            ' · <a href="../walkthrough/">Walkthrough</a></footer>' + (COPY_SCRIPT if requests else '') + '</body></html>')


def metadata(url: str, title: str, description: str, theme_color: str) -> str:
    url, title, description, theme_color = (html.escape(value, quote=True)
                                            for value in (url, title, description, theme_color))
    return (f'<link rel="canonical" href="{url}"><meta name="description" content="{description}">'
            f'<meta name="theme-color" content="{theme_color}"><meta property="og:type" content="website">'
            '<meta property="og:site_name" content="Codex Plus">'
            f'<meta property="og:url" content="{url}"><meta property="og:title" content="{title}">'
            f'<meta property="og:description" content="{description}">')


def write_sitemap(output: Path) -> None:
    (output / 'sitemap.xml').write_text('<?xml version="1.0" encoding="UTF-8"?>\n'
        '<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">' + ''.join(
            '<url><loc>' + xml_escape(url) + '</loc></url>' for url in PUBLIC_PAGES.values()) + '</urlset>\n')


class PageFacts(HTMLParser):
    def __init__(self, text: str):
        super().__init__()
        self.canonical = []
        self.descriptions = []
        self.social_urls = []
        self.ids: set[str] = set()
        self.main_count = 0
        self.h1_count = 0
        self.feed(text)
        self.close()

    def handle_starttag(self, tag, attrs):
        attrs = dict(attrs)
        if tag == 'link' and attrs.get('rel') == 'canonical':
            self.canonical.append(attrs.get('href'))
        if tag == 'meta' and attrs.get('name') == 'description':
            self.descriptions.append(attrs.get('content'))
        if tag == 'meta' and attrs.get('property') == 'og:url':
            self.social_urls.append(attrs.get('content'))
        if attrs.get('id'):
            self.ids.add(attrs['id'])
        self.main_count += tag == 'main'
        self.h1_count += tag == 'h1'


def walkthrough_fragment_links(overview: str, walkthrough: str) -> str:
    moved = PageFacts(walkthrough).ids - PageFacts(overview).ids
    entries = []
    for identifier in sorted(moved):
        label = WALKTHROUGH_SECTIONS.get(identifier, 'this example or control')
        target = html.escape(identifier, quote=True)
        entries.append(f'<aside class="fragment-entry wrap" id="{target}">'
                       f'<a href="./walkthrough/#{target}">Open {label} in the walkthrough →</a></aside>')
    return '\n'.join(entries)


def validate_publication(output: Path, source_root: Path = ROOT) -> None:
    allowed = {*PUBLIC_PAGES, *RAW_GUIDES, 'assets/architecture.svg', '.nojekyll', 'sitemap.xml'}
    actual = {p.relative_to(output).as_posix() for p in output.rglob('*') if p.is_file()}
    if actual != allowed:
        raise ValueError(f'public file inventory differs: missing={sorted(allowed-actual)}, extra={sorted(actual-allowed)}')
    for target, source in RAW_GUIDES.items():
        if (output / target).read_bytes() != (source_root / 'docs' / source).read_bytes():
            raise ValueError(f'raw guide differs from authored source: {target}')
    for name, url in PUBLIC_PAGES.items():
        facts = PageFacts((output / name).read_text())
        if facts.canonical != [url] or facts.social_urls != [url]:
            raise ValueError(f'public URL metadata differs in {name}')
        if len(facts.descriptions) != 1 or not facts.descriptions[0]:
            raise ValueError(f'public description is missing or duplicated in {name}')
        if facts.main_count != 1 or facts.h1_count != 1:
            raise ValueError(f'public page needs one main and one h1 in {name}')
    sitemap = ElementTree.fromstring((output / 'sitemap.xml').read_text())
    urls = [element.text for element in sitemap.findall('{*}url/{*}loc')]
    if sorted(urls) != sorted(PUBLIC_PAGES.values()):
        raise ValueError('public sitemap differs from published routes')


def validate(output: Path) -> int:
    count = 0
    for path in output.rglob("*.html"):
        text = path.read_text()
        identifiers = re.findall(r'\bid="([^"]+)"', text)
        if len(identifiers) != len(set(identifiers)):
            raise ValueError(f"duplicate site id in {path.relative_to(output)}")
        for url in re.findall(r'\b(?:href|src)="([^"]+)"', text):
            parsed = urlsplit(html.unescape(url))
            if parsed.scheme or parsed.netloc:
                continue
            target = (path.parent / unquote(parsed.path)).resolve() if parsed.path else path
            if target.is_dir():
                target /= "index.html"
            if not target.is_relative_to(output) or not target.is_file():
                raise ValueError(f"broken site link in {path.relative_to(output)}: {url}")
            if parsed.fragment and target.suffix in {".html", ".svg"}:
                identifiers = set(re.findall(r'\bid="([^"]+)"', target.read_text()))
                if unquote(parsed.fragment) not in identifiers:
                    raise ValueError(f"broken site anchor in {path.relative_to(output)}: {url}")
            count += 1
    return count


def validate_current_guides(root: Path = ROOT) -> int:
    """Check published and managed claims independently of source/artifact versions."""
    readme = (root / "README.md").read_text()
    count = 0
    for domain, claims in CURRENT_RELEASE_CLAIMS.items():
        anchors = re.findall(claims["README.md"][0], readme)
        if len(anchors) != 1:
            reason = "missing" if not anchors else "ambiguous"
            raise ValueError(f"{reason} {domain} release anchor in README.md: found {len(anchors)}")
        version = anchors[0]
        if not re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?"
                            r"(?:\+[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?", version):
            raise ValueError(f"malformed {domain} release anchor in README.md: {version!r}")
        for name, patterns in claims.items():
            text = (root / name).read_text()
            for pattern in patterns:
                values = re.findall(pattern, text)
                if not values:
                    raise ValueError(f"{domain} release claim missing in {name}: {pattern}")
                for value in values:
                    actual = version.split("-", 1)[0] + "-" + value if value.startswith("preview.") else value
                    if actual != version:
                        raise ValueError(f"inconsistent {domain} release claim in {name}: {value}; "
                                         f"expected {version} from README.md")
                    count += 1
    workers = (root / "docs/workers.md").read_text()
    for workflow in ("$luna-task", "$luna-goal-loop", "$adaptive-task", "$adaptive-goal-loop",
                     "$sol-task", "$astra-task", "$terra-task", "skills/html-report"):
        if workflow not in workers:
            raise ValueError(f"named workflow missing from worker guide: {workflow}")
    installation = re.search(r"(?ms)^## Installation\s*\n(.*?)(?=^## |\Z)", workers)
    if not installation:
        raise ValueError("worker installation section is missing")
    install_text = installation.group(1)
    selector = re.compile(
        r"\[[^\]]+\]\(manage-agent\.md#resolve-and-verify-one-published-release\)"
    )
    if not selector.search(install_text):
        raise ValueError("worker installation must link to the canonical release selector")
    pinned_archive = re.compile(
        r"\bcodex-plus-workers-\d+\.\d+\.\d+(?:-[\w.+-]+)?\.tar\.gz\b|"
        r"https?://github\.com/byebyebryan/codex-plus/releases/(?:download|tag)/"
        r"v?\d+\.\d+\.\d+[^\s)]*|"
        r"\bverified\s+preview\.\d+\s+(?:worker\s+)?release\s+archive\b|"
        r"\bpreview\.\d+(?:['’]s)?\s+(?:verified\s+)?"
        r"(?:worker\s+)?(?:release\s+)?archive\b",
        re.I,
    )
    if pinned_archive.search(install_text):
        raise ValueError("worker installation must not pin a numbered preview archive")
    return count


def fill_marker(page: str, marker: str, content: str) -> str:
    placeholder = f'<!-- {marker} -->'
    if page.count(placeholder) != 1:
        raise ValueError(f'expected exactly one presentation placeholder: {marker}')
    return page.replace(placeholder, content)


def presentation_page(source: str, route: str, theme_color: str) -> str:
    descriptions = PageFacts(source).descriptions
    title = re.search(r'<title>(.*?)</title>', source, re.S)
    if len(descriptions) != 1 or not descriptions[0] or not descriptions[0].strip() or not title:
        raise ValueError('presentation page needs a title and one nonempty description')
    page = links(source, '../' if route else './')
    page = re.sub(r'<meta name="description"[^>]+>', '', page)
    page_metadata = metadata(SITE + route, html.unescape(title[1]), descriptions[0], theme_color)
    page = page.replace('</head>', page_metadata + '</head>')
    page = page.replace('</body>', COPY_SCRIPT + '</body>')
    # Preserve internal snapshot references with an explicit reachability label.
    return re.sub(r'(<a href="http://(?:snap|starship):[^\"]+">)(.*?)(</a>)', r'\1\2 (mesh access)\3', page)


def overview_page(source: str, walkthrough: str, icon: str, theme: tuple[str, str], install: str) -> str:
    page = fill_marker(source, 'site-icon', icon)
    page = fill_marker(page, 'site-theme', theme[0])
    page = fill_marker(page, 'walkthrough-fragments', walkthrough_fragment_links(page, walkthrough))
    install_control = ('<textarea id="install-request-text" class="install-prompt" aria-label="Install request to paste into your agent" '
                       f'readonly rows="3">{html.escape(install)}</textarea>'
                       f'<div class="copy-tools" data-copy-source="install-request-text">{copy_control(install, "Install")}</div>')
    return presentation_page(fill_marker(page, 'install-request', install_control), '', theme[1])


def build(output: Path) -> None:
    claims = validate_current_guides()
    requests = lifecycle_requests((ROOT / 'docs/manage-agent.md').read_text())
    output = output.resolve()
    if output == ROOT or output.is_relative_to(ROOT):
        raise ValueError("Pages output must be outside the source checkout")
    if output.exists() and any(output.iterdir()):
        raise ValueError("Pages output must be empty")
    output.mkdir(parents=True, exist_ok=True)
    walkthrough = (ROOT / 'docs/presentation/index.html').read_text()
    overview = (ROOT / 'docs/presentation/overview.html').read_text()
    theme = site_theme(walkthrough)
    icon = re.search(r'<link rel="icon"[^>]+>', walkthrough)
    if not icon:
        raise ValueError("presentation icon is missing")
    (output / 'index.html').write_text(overview_page(overview, walkthrough, icon[0], theme, requests['Install']))
    walkthrough = fill_marker(walkthrough, 'management-requests', action_cards(requests))
    (output / 'walkthrough').mkdir()
    (output / 'walkthrough/index.html').write_text(presentation_page(walkthrough, 'walkthrough/', theme[1]))
    (output / "assets").mkdir()
    shutil.copyfile(ROOT / "docs/presentation/architecture.svg", output / "assets/architecture.svg")
    for name, (route, title) in GUIDES.items():
        markdown = (ROOT / "docs" / name).read_text()
        body = render(markdown)
        if name == "architecture.md":
            body = architecture_diagram(body, markdown)
        body = guide_figure(name, links(headings(body), '../'))
        page = output / route
        page.mkdir()
        (page / "index.html").write_text(guide_page(name, route, title, body, icon[0], theme,
            requests if route == 'manage' else None))
    write_raw_guides(output)
    (output / ".nojekyll").write_text("")
    write_sitemap(output)
    count = validate(output)
    validate_publication(output)
    print(f"Built overview, walkthrough and {len(GUIDES)} guides; {count} local links/assets/anchors, "
          f"{claims} current-release claims and public metadata verified: {output}")


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", required=True, type=Path)
    args = parser.parse_args()
    build(args.output)


if __name__ == "__main__":
    main()
