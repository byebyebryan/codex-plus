html{scroll-padding-top:20px}h2[id]{scroll-margin-top:20px}.table-scroll:focus-visible{outline:3px solid #b04e29;outline-offset:3px}td code{white-space:nowrap}
.more{display:flex;flex-wrap:wrap;gap:10px 22px;margin-top:40px;padding-top:20px;border-top:1px solid var(--line);font-size:14px}.more strong{flex-basis:100%}
