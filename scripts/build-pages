COPY_SCRIPT = """<script>
document.querySelectorAll('[data-copy-request]').forEach(button => {
  button.hidden = false;
  const container = button.parentElement;
  const sourceId = container.dataset.copySource;
  const source = sourceId ? document.getElementById(sourceId) : null;
  const status = container.querySelector('[role="status"]');
  let field = source;
  button.addEventListener('click', async () => {
    const text = button.dataset.copyRequest;
    let copied = false;
    if (navigator.clipboard && window.isSecureContext) {
      try {
        await navigator.clipboard.writeText(text);
        copied = true;
      } catch {}
    }
    if (!copied) {
      if (!field) {
        field = document.createElement('textarea');
        field.readOnly = true;
        field.setAttribute('aria-label', 'Request for manual copying');
        container.appendChild(field);
      }
      field.hidden = false;
      field.value = text;
      field.focus();
      field.select();
      try { copied = document.execCommand('copy'); } catch {}
    }
    if (copied) {
      if (field && field !== source) field.hidden = true;
      button.focus();
    }
    status.textContent = copied ? 'Request copied.' : 'Select the request text and copy it manually.';
  });
});
</script>"""


def lifecycle_requests(markdown: str) -> dict[str, str]:
    names = ('Install', 'Upgrade', 'Inspect', 'Configure', 'Roll back', 'Clean up', 'Uninstall')
    rows = re.findall(r'^\| ([^|]+) \| (Read [^|]+) \|$', markdown, re.M)
    requests = dict(rows)
    if len(rows) != len(names) or set(requests) != set(names) or any(
            not value.startswith('Read ' + SITE + 'manage.md and ') for value in requests.values()):
        raise ValueError('agent action requests must use the canonical Markdown guide')
    return requests


def copy_control(request: str, action: str) -> str:
    return ('<button type="button" class="copy-action" aria-label="' +
            html.escape('Copy ' + action.lower() + ' request', quote=True) +
            '" hidden data-copy-request="' +
            html.escape(request, quote=True) + '">Copy request</button>'
            '<span class="copy-result" role="status"></span>')


def action_cards(requests: dict[str, str]) -> str:
    return '<div class="agent-actions">' + ''.join(
        '<article><h3>' + name + '</h3><p>' + html.escape(requests[name]) + '</p>' +
        copy_control(requests[name], name) + '</article>' for name in ('Install', 'Upgrade')) + '</div>'


def action_table(body: str, requests: dict[str, str]) -> str:
    actions = {request: name for name, request in requests.items()}
    seen: list[str] = []

    def cell(match):
        text = html.unescape(re.sub(r'<[^>]*>', '', match[2])).strip()
        if text not in actions:
            return match[0]
        seen.append(text)
        return '<td' + match[1] + '>' + match[2] + copy_control(text, actions[text]) + '</td>'

    result = re.sub(r'<td\b([^>]*)>(.*?)</td>', cell, body, flags=re.S)
    if sorted(seen) != sorted(actions):
        raise ValueError('rendered agent action requests must each appear once')
    return result


def write_raw_guides(output: Path, source_root: Path = ROOT) -> None:
    for target, source in RAW_GUIDES.items():
        (output / target).write_bytes((source_root / 'docs' / source).read_bytes())


