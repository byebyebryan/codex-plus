#!/usr/bin/env python3
"""Build the public guides outside the checkout using GitHub's GFM renderer."""

from __future__ import annotations

import argparse
import hashlib
import html
from html.parser import HTMLParser
import json
from pathlib import Path
import re
import shutil
import subprocess
from urllib.parse import unquote, urlsplit
from xml.sax.saxutils import escape as xml_escape
from xml.etree import ElementTree


ROOT = Path(__file__).resolve().parents[1]
REPOSITORY = "byebyebryan/codex-plus"
SITE = "https://dev.byebyebryan.com/codex-plus/"
SOURCE = f"https://github.com/{REPOSITORY}/blob/main/docs/"
GUIDES = {
    "getting-started.md": ("start", "Get started"),
    "daily-use.md": ("daily-use", "Daily use"),
    "workers.md": ("workers", "Luna & workers"),
    "architecture.md": ("architecture", "How it works"),
    "environments.md": ("environments", "Environments"),
    "soak-checklist.md": ("soak-checklist", "Daily trial"),
    "html-report-usage.md": ("reports", "Reporting"),
    "runtime-distribution.md": ("installation", "Installation"),
}
DESCRIPTIONS = {
    "getting-started.md": "Choose workers, monitoring and reporting, then follow the setup path for your Codex environment.",
    "daily-use.md": "Everyday requests for worker tasks, watches, later checks, session coordination and browser reports.",
    "workers.md": "Use Luna tasks and goal loops or adaptive worker workflows while your primary owns decisions and review.",
    "architecture.md": "Understand Codex Plus components, source access, discovery, costs, receipts and lifecycle boundaries.",
    "environments.md": "Select a Codex home and keep conversations, MCP tools, follow-up state and reports in the intended context.",
    "soak-checklist.md": "Record useful outcomes and friction during ordinary work, with private evidence and clear acceptance limits.",
    "html-report-usage.md": "Publish immutable HTML reports, organize the project catalog and configure independent hosting.",
    "runtime-distribution.md": "Verify and install the monitoring runtime, configure its MCP tools and select immutable releases.",
}
STYLE = """
