#!/usr/bin/env python3
"""Validate the public Codex Plus bundle without third-party dependencies."""

from __future__ import annotations

import json
import re
import stat
import sys
import tomllib
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
SKILLS = (
    "luna-task",
    "worker-task",
    "luna-goal-loop",
    "worker-goal-loop",
)
LEGACY_SKILLS = ("terra-task", "terra-goal-loop")
EXPLICIT_ADAPTIVE_SKILLS = {"worker-task", "worker-goal-loop"}
AGENTS = {
    "agents/luna-max.toml": ("gpt-6-luna", "max"),
    "agents/sol-xhigh.toml": ("gpt-6.1-sol", "xhigh"),
    "legacy/agents/terra-xhigh.toml": ("gpt-5.6-terra", "xhigh"),
}
EXPECTED_FILES = {
    "AGENTS.md",
    "README.md",
    "LICENSE",
    "scripts/check",
    "tests/test_check.py",
    "tests/test_monitoring_spike.py",
    "tests/test_monitoring_control.py",
    "tests/test_watch_store.py",
    "tests/test_watch_engine.py",
    "tests/test_watch_cli.py",
    "docs/codex-plus-plan.md",
    "docs/claude-monitoring-context.md",
    "docs/implementation-handoff.md",
    "docs/monitoring-spike-results.md",
    "docs/coordinator-loop-results.md",
    "docs/peer-watch-results.md",
    "docs/interaction-pass-results.md",
    "docs/watch-candidate.md",
    "spikes/monitoring/native.py",
    "spikes/monitoring/control.py",
    "spikes/monitoring/simulator.py",
    "spikes/monitoring/spike.py",
    "spikes/monitoring/probe_sources.py",
    "codex_plus/__init__.py",
    "codex_plus/native.py",
    "codex_plus/control.py",
    "codex_plus/framing.py",
    "codex_plus/store.py",
    "codex_plus/engine.py",
    "codex_plus/cli.py",
    "codex_plus/peers.py",
    "codex_plus/peer_cli.py",
    "codex_plus/presentation.py",
    "scripts/codex-plus-watch",
    "scripts/codex-plus-peer",
    "tests/test_peers.py",
    "tests/test_peer_watch.py",
    "tests/test_presentation.py",
    "docs/worker-routing-design.md",
    "docs/worker-routing-study.md",
    *AGENTS,
}
SKILL_PATHS = tuple(f"skills/{skill}" for skill in SKILLS) + tuple(
    f"legacy/skills/{skill}" for skill in LEGACY_SKILLS
)
for skill_path in SKILL_PATHS:
    EXPECTED_FILES.update(
        {
            f"{skill_path}/SKILL.md",
            f"{skill_path}/agents/openai.yaml",
        }
    )


def fail(message: str) -> None:
    print(f"[FAIL] {message}", file=sys.stderr)
    raise SystemExit(1)


def relative(path: Path) -> str:
    return path.relative_to(ROOT).as_posix()


def inventory() -> set[str]:
    paths: set[str] = set()
    for path in ROOT.rglob("*"):
        if ".git" in path.relative_to(ROOT).parts:
            continue
        if path.is_file() or path.is_symlink():
            paths.add(relative(path))
    return paths


def read_required(path: Path, label: str) -> str:
    try:
        return path.read_text(encoding="utf-8")
    except OSError as error:
        fail(f"could not read {label}: {error}")


def check_inventory() -> None:
    actual = inventory()
    missing = sorted(EXPECTED_FILES - actual)
    unexpected = sorted(actual - EXPECTED_FILES)
    if missing:
        fail(f"missing files: {', '.join(missing)}")
    if unexpected:
        fail(f"unexpected files: {', '.join(unexpected)}")

    for name in sorted(EXPECTED_FILES):
        path = ROOT / name
        if path.is_symlink():
            fail(f"public file must not be a symlink: {name}")
        if not path.is_file():
            fail(f"expected regular file is missing: {name}")

    mode = (ROOT / "scripts/check").stat().st_mode
    if not mode & (stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH):
        fail("scripts/check is not executable")

    print(f"[ok] expected inventory ({len(EXPECTED_FILES)} files)")


def check_agents() -> None:
    required = {
        "name",
        "description",
        "model",
        "model_reasoning_effort",
        "developer_instructions",
    }
    for agent_path, expected_selection in AGENTS.items():
        path = ROOT / agent_path
        name = relative(path)
        try:
            data = tomllib.loads(read_required(path, name))
        except tomllib.TOMLDecodeError as error:
            fail(f"invalid TOML in {name}: {error}")
        missing = sorted(required - data.keys())
        if missing:
            fail(f"{name} is missing agent fields: {', '.join(missing)}")
        for field in sorted(required):
            value = data[field]
            if not isinstance(value, str) or not value.strip():
                fail(f"{name} has an empty or non-string {field} field")
        if data["name"] != path.stem:
            fail(f"agent name does not match filename: {name}")
        selection = (data["model"], data["model_reasoning_effort"])
        if selection != expected_selection:
            fail(f"model/effort drift in {name}: {selection} != {expected_selection}")
    print("[ok] agent TOML, required fields, and model/effort selections")


def frontmatter(text: str, name: str) -> dict[str, str]:
    lines = text.splitlines()
    if not lines or lines[0].strip() != "---":
        fail(f"{name} does not start with YAML frontmatter")
    try:
        end = lines.index("---", 1)
    except ValueError:
        fail(f"{name} has an unterminated YAML frontmatter block")

    fields: dict[str, str] = {}
    for line in lines[1:end]:
        if not line.strip():
            continue
        if ":" not in line or line.startswith((" ", "\t")):
            fail(f"unsupported frontmatter line in {name}: {line!r}")
        key, value = line.split(":", 1)
        if key in fields:
            fail(f"duplicate frontmatter field in {name}: {key}")
        fields[key] = value.strip()
    for key in ("name", "description"):
        if not fields.get(key):
            fail(f"{name} frontmatter is missing {key}")
    return fields


def parse_metadata(text: str, name: str) -> dict[str, dict[str, str | bool]]:
    """Parse the kit's two-level YAML mappings; reject unsupported YAML forms."""
    if re.search(
        r"[\x00-\x08\x0b\x0c\x0e-\x1f\x7f-\x84\x86-\x9f\ud800-\udfff\ufffe\uffff]",
        text,
    ):
        fail(f"metadata contains a non-printable YAML character: {name}")
    schema = {
        "interface": {
            "display_name": str,
            "short_description": str,
            "default_prompt": str,
        },
        "policy": {"allow_implicit_invocation": bool},
    }
    blocks: dict[str, dict[str, str | bool]] = {}
    block = ""
    for number, line in enumerate(text.splitlines(), 1):
        if not line.strip() or line.lstrip(" ").startswith("#"):
            continue
        header = re.fullmatch(r"([a-z_]+):(?: +#.*| *)", line)
        if header:
            block = header.group(1)
            if block not in schema or block in blocks:
                fail(f"unsupported or duplicate metadata block in {name}:{number}: {block}")
            blocks[block] = {}
            continue
        field = re.fullmatch(r"  ([a-z_]+): +(.+)", line)
        if not field or not block:
            fail(f"unsupported metadata line in {name}:{number}: {line!r}")
        key, raw = field.groups()
        if key not in schema[block] or key in blocks[block]:
            fail(f"unsupported or duplicate metadata field in {name}:{number}: {block}.{key}")
        value: str | bool
        if schema[block][key] is bool:
            boolean = re.fullmatch(r"(true|false)(?: +#.*| *)", raw)
            if not boolean:
                fail(f"metadata {block}.{key} must be a boolean: {name}:{number}")
            value = boolean.group(1) == "true"
        else:
            quoted = re.fullmatch(
                r'''("(?:[^"\\]|\\.)*"|'(?:[^']|'')*')(?: +#.*| *)''', raw
            )
            if not quoted:
                fail(f"metadata {block}.{key} must be a quoted string: {name}:{number}")
            scalar = quoted.group(1)
            if scalar.startswith('"'):
                try:
                    value = json.loads(scalar)
                    value.encode("utf-8")
                    for escape in re.findall(r"\\(?:u[0-9a-fA-F]{4}|.)", scalar):
                        if (
                            escape.startswith("\\u")
                            and 0xD800 <= int(escape[2:], 16) <= 0xDFFF
                        ):
                            raise ValueError("YAML does not support surrogate escapes")
                except (ValueError, UnicodeEncodeError) as error:
                    fail(f"unsupported quoted string in {name}:{number}: {error}")
            else:
                value = scalar[1:-1].replace("''", "'")
            if not value.strip():
                fail(f"metadata {block}.{key} must not be empty: {name}:{number}")
        blocks[block][key] = value
    return blocks


def check_metadata(text: str, skill: str, name: str) -> None:
    data = parse_metadata(text, name)
    interface = data.get("interface", {})
    for field in ("display_name", "short_description", "default_prompt"):
        if field not in interface:
            fail(f"skill metadata is missing interface.{field}: {name}")
    prompt = interface["default_prompt"]
    if not re.search(rf"\${re.escape(skill)}(?![a-z0-9-])", prompt):
        fail(f"default prompt must name ${skill}: {name}")
    if skill in EXPLICIT_ADAPTIVE_SKILLS:
        if data.get("policy", {}).get("allow_implicit_invocation") is not False:
            fail(f"adaptive skill must disable implicit invocation: {name}")


def check_skills() -> None:
    for skill_path in SKILL_PATHS:
        skill_dir = ROOT / skill_path
        skill = skill_dir.name
        skill_file = skill_dir / "SKILL.md"
        fields = frontmatter(read_required(skill_file, relative(skill_file)), skill)
        if fields["name"] != skill:
            fail(f"skill frontmatter name does not match directory: {skill}")

        metadata = skill_dir / "agents" / "openai.yaml"
        metadata_name = relative(metadata)
        check_metadata(read_required(metadata, metadata_name), skill, metadata_name)
    print(
        f"[ok] skill frontmatter and metadata "
        f"({len(SKILLS)} default, {len(LEGACY_SKILLS)} legacy skills)"
    )


def main() -> int:
    check_inventory()
    check_agents()
    check_skills()
    print("[ok] all checks passed")
    return 0


if __name__ == "__main__":
    sys.exit(main())
